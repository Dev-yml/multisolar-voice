# Copy to apps/console/.env (npm run setup does this for you). Never commit or share the real file.

# --- Database: Supabase (Project → Connect → ORMs → Prisma) ---
# App connection: "Transaction pooler", port 6543. Keep ?pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_DB_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Migrations: "Session pooler", port 5432
DIRECT_URL="postgresql://postgres.PROJECT_REF:YOUR_DB_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"
# Special characters in the password must be URL-encoded (# → %23, @ → %40, / → %2F). npm run setup does this.

# 32+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
AUTH_SECRET=""

# Shared secret the Voice Agent server uses to call the Console's internal API. 32+ random characters.
AGENT_API_KEY=""

# First Super Admin, created by the seed. Password: 12+ characters.
SEED_ADMIN_NAME="IT Admin"
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# --- Later (leave empty until each account is ready) ---
# SARVAM_API_KEY=""        # Sarvam: speech-to-text + text-to-speech (Hindi/English); also gives Test call a natural voice
# SARVAM_TTS_SPEAKER=""    # Optional: Sarvam voice name (see Sarvam docs); empty = Sarvam's default voice
# SARVAM_TTS_MODEL=""      # Optional: e.g. a newer Bulbul model; empty = Sarvam's default
# SMARTFLO_API_TOKEN=""    # Tata Smartflo API token
# SMARTFLO_CALLER_ID=""    # The company number (DID) used for outbound calls
# ANTHROPIC_API_KEY=""     # Claude: smarter free-form answers (optional)

# --- Speed (optional) ---
# DB_CONNECTION_LIMIT=10   # Parallel database connections (default 10 on a laptop/server, 5 on Vercel)
