# Voice Agent server settings. On Fly.io / Railway put these in the app's secrets / variables instead.
# npm run voice:env creates apps/voice/.env for local runs from apps/console/.env.

# Same database and shared key as the Console
DATABASE_URL=""
AGENT_API_KEY=""

# Public https address of this server (Fly: https://<app>.fly.dev). Used to build the wss:// URL.
PUBLIC_URL="http://localhost:8080"
# Secret part of the URLs given to Smartflo (Voice Bot, dynamic endpoint, webhook). 32+ characters.
STREAM_KEY=""

# AI conversation (Claude). Without it the built-in rule engine answers. Model: Agent settings in the Console.
ANTHROPIC_API_KEY=""

# Speech (Sarvam). Without a key the server uses silent "mock" speech (simulation only).
SARVAM_API_KEY=""
# SARVAM_TTS_SPEAKER=""       # optional voice name from Sarvam's list
# SARVAM_TTS_MODEL=""         # optional, e.g. bulbul:v3
# SARVAM_STT_MODEL=""         # optional, e.g. saaras:v4

# Tata Smartflo. Without these the server uses the built-in simulator (SMARTFLO_MODE=sim).
SMARTFLO_API_TOKEN=""          # API Connect → API Tokens
SMARTFLO_C2C_API_KEY=""        # API Connect → Click to Call Support API → API key (destination: Voice Bot)
# Company numbers shown to customers, comma-separated (outbound calls take turns using them).
SMARTFLO_CALLER_IDS="918065378787"
# Click to Call path used to connect a caller to Sales / Sales Head / CRM (ring the team member, then the customer).
# SMARTFLO_BRIDGE_PATH="/v1/click_to_call"

# Dialer (defaults are fine): DIALER=off to disable automatic calling
# DIALER_TICK_MS=15000
# COST_PAISE_PER_MIN=730       # cost per answered minute in paise (Tata ₹5 + Sarvam + Claude ≈ ₹7.30), for the monthly budget
